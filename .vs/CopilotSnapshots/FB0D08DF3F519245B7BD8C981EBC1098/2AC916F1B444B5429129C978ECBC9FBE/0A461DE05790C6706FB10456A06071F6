#include "Player.h"
#include "DxLib.h"
#include "Game.h"
#include"SceneMain.h"

namespace
{
	// 画面の左半分の中央に配置するためのオフセット
	constexpr int m_ScreenX = Game::kScreenWidth / 4;
	constexpr int m_ScreenY = Game::kScreenHeight / 2;
}

Player::Player() :
	m_idleGraph(-1),
	m_x(0),
	m_y(0),
	m_width(0),
	m_height(0)
{
}

Player::~Player()
{
}

void Player::Init()
{
	// グラフィックが有効ならサイズを取得して左半分の中央に配置
	if (m_idleGraph >= 0)
	{
		GetGraphSize(m_idleGraph, &m_width, &m_height);
	}
	else
	{
		m_width = 0;
		m_height = 0;
	}

	// 左半分の中央を基準に中央寄せ
	m_x = (m_ScreenX) - (m_width / 2);
	m_y = (m_ScreenY) - (m_height / 2);
}

void Player::Update()
{
	// アニメーションのフレームを進める
	m_frameIndex++;
	if (m_frameIndex == 10)m_frameIndex = 0;

	//一定時間待つ
	WaitTimer(100);
}

void Player::Draw()
{
	DrawGraph(0, 0, [m_frameIndex], TRUE);
}

void Player::Release()
{
}
