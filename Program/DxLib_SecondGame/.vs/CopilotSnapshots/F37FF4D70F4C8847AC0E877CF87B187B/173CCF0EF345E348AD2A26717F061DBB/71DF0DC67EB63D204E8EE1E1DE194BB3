#include "SceneMain.h"
#include"DxLib.h"
#include"Game.h"
#include"SceneTitle.h"

namespace
{
	constexpr int kFadeFrame = 30;
	//ゲーム開始前の待ち時間（フレーム数）
	constexpr int kWaitFrame = 60 *3;
}

SceneMain::SceneMain() :
	m_frameCount(0),
	m_playerHandle(-1),
	m_enemyGraphHandle(-1),
	m_lifeGraphHandle(-1),
	m_bgGraphHandle(-1),
	m_gameoverFontHandle(-1),
	m_fadeFrame(0),
	m_fadeSpeed(0),
	m_sinAngle(0.0f),
	m_waitFrame(0),
	m_score(0),
	m_dispScore(0),
	m_isEnd(false)
{
}

SceneMain::~SceneMain()
{
}

void SceneMain::Init()
{
	//グラフィックリソースのロード
	m_playerHandle = LoadGraph("data/image/idle.png");
	m_enemyGraphHandle = LoadGraph("data/image/Saw.png");
	m_lifeGraphHandle = LoadGraph("data/image/Kiwi.png");
	m_bgGraphHandle = LoadGraph("data/image/mapchip.png");

	//フォントの生成
	m_gameoverFontHandle = CreateFontToHandle("ＭＳ 明朝", 48, -1, -1);

	m_player.SetIdleHandle(m_playerHandle);
	m_player.Init();

	m_enemy.SetGraphHandle(m_enemyGraphHandle);
	m_enemy.Init();

	for (int i = 0;i < kLifeMax;i++)
	{
		m_life[i].SetGraphHandle(m_lifeGraphHandle);
		m_life[i].Init();
		Vec2 pos;
		pos.x = Game::kScreenWidth / 2 - 120 + 120 * i;
		pos.y = 160;
		m_life[i].SetPos(pos);
	}

	m_bg.SetHandle(m_bgGraphHandle);
	m_bg.Init();

	m_fadeFrame = kFadeFrame;
	m_fadeSpeed = -1;

	//ゲーム開始前の待ち時間を設定
	m_waitFrame = kWaitFrame;

	m_frameCount = 0;
	m_score = 0;
	m_dispScore = 0;
	m_isEnd = false;
}

void SceneMain::End()
{
	//グラフィックを開放
	DeleteGraph(m_playerHandle);
	DeleteGraph(m_enemyGraphHandle);
	DeleteGraph(m_bgGraphHandle);

	//フォントの削除
	DeleteFontToHandle(m_gameoverFontHandle);

	m_player.End();
	m_enemy.End();
	for (int i = 0;i < kLifeMax;i++)
	{
		m_life[i].End();
	}
	m_bg.End();
}

void SceneMain::Update()
{
	m_frameCount++;
	m_fadeFrame += m_fadeSpeed;
	if (m_fadeFrame < 0) m_fadeFrame = 0;
	if (m_fadeFrame > kFadeFrame)
	{
		m_fadeFrame = kFadeFrame;
		m_isEnd = true;
	}
	m_sinAngle += 0.05f;

	//ゲーム開始待ち時間のカウント
	m_waitFrame--;
	m_player.Update();
	if (m_waitFrame <= 0);
	{
		m_enemy.Update();
	}
	for (int i = 0;i < kLifeMax;i++)
	{
		m_life[i].Update();
	}
	//当たり判定
	{
		//playerの中心からenemyの中心に伸びるベクトルを取得する
		//終点の座標からして院の座標を引くことで視点から終点へのベクトルを求める
		Vec2 playerToEnemy;
		playerToEnemy.x = m_enemy.GetColCenter().x - m_player.GetColCenter().x;
		playerToEnemy.y = m_enemy.GetColCenter().y - m_player.GetColCenter().y;

		//半径の合計
		float sumRadius = m_player.GetColRadius() + m_enemy.GetColRadius();
		if (playerToEnemy.SqLength() < (sumRadius * sumRadius))
		{
			//	printfDx("当たった\n");
			m_player.OnHit();
		}
		m_bg.Update();
	}
	//ライフの数だけライフのアイコンを表示する
	for (int i = 0;i < kLifeMax;i++)
	{
		//m_life[i].SetVisible(i < m_player.GetHp());
		if (i < m_player.GetHp())
		{
			m_life[i].SetActive(true);
		}
		else
		{
			m_life[i].SetActive(false);
		}
	}
	//現在のスコアを計算する
//	if(m_player.IsDead() == false)
	if (!m_player.IsDead())
	{
		//のこぎりがプレイヤーのX座標をまた井田らスコアアップ
		float centerX = m_player.GetPos().x;
		//のこぎりの位置情報
		float enemyX = m_enemy.GetPos().x;
		float lastX = m_enemy.GetLastPos().x;
		if ((enemyX < centerX) && (lastX >= centerX))
		{
			m_score += 100;
		}
		if ((enemyX >= centerX) && (lastX < centerX))
		{
			m_score += 100;
		}
		//m_score = m_enemy.GetAppearCount() * 100;
	}
	//見せる用のスコア更新
	if (m_score > m_dispScore)
	{
		m_dispScore += 8;
		if (m_score < m_dispScore)m_dispScore = m_score;
	}

	if (m_player.IsDead())
	{
		int pad = GetJoypadInputState(DX_INPUT_KEY_PAD1);
		if (pad & PAD_INPUT_1)
		{
			//フェードアウトを開始
			m_fadeSpeed = +1;

			//フェードアウトが終わったらシーンを終了するよう変更

			//	printfDx("ゲーム開始!\n");
				//タイトル画面を終了してゲームへ
			//m_isEnd = true;
		}
	}
}

void SceneMain::Draw()
{
	m_bg.Draw();
	m_player.Draw();
	m_enemy.Draw();
	for (int i = 0;i < kLifeMax;i++)
	{
		m_life[i].Draw();
	}
	//スコア(のこぎり登場回数)
	{
		//文字列の横幅をお取得する
		int width = GetDrawFormatStringWidthToHandle(m_gameoverFontHandle, "%d", m_dispScore);

		//右揃えで表示
		int x = (Game::kScreenWidth - 32) - width;
		int y = 32;
		DrawFormatStringToHandle(x, y, GetColor(255, 255, 255), m_gameoverFontHandle, "%d", m_dispScore);
	}
	//開始待ち表示
	if (m_waitFrame > 0)
	{
		//文字列の横幅を取得
		int width = GetDrawStringWidthToHandle("REDY", strlen("REDY"), m_gameoverFontHandle);

		int x = Game::kScreenWidth / 2 - width / 2 + cosf(m_sinAngle) * 11;
		int y = 200 + sinf(m_sinAngle) * 16;
		DrawStringToHandle(x, y, "REDY", GetColor(200, 32, 32), m_gameoverFontHandle);
	}

	//ゲームオーバー表示
	if (m_player.IsDead())
	{
		//文字列の横幅を取得
		int width = GetDrawStringWidthToHandle("GAME OVER!", strlen("GAME OVER!"), m_gameoverFontHandle);

		int x = Game::kScreenWidth / 2 - width / 2 + cosf(m_sinAngle) * 11;
		int y = 200 + sinf(m_sinAngle) * 16;
		DrawStringToHandle(x, y, "GAME OVER!", GetColor(200, 32, 32), m_gameoverFontHandle);
	}

	//フェード
	float frameRate = static_cast<float>(m_fadeFrame) / static_cast<float>(kFadeFrame);//浮動小数の計算にするためキャスト
	//0.0~1.0の割合を0~255の値に変換する
	int alpha = static_cast<int>(255 * frameRate);
	//半透明ので表示
	SetDrawBlendMode(DX_BLENDMODE_ALPHA, alpha);
	DrawBox(0, 0, Game::kScreenWidth, Game::kScreenHeight, GetColor(0, 0, 0), true);
	//半透明を終了
	SetDrawBlendMode(DX_BLENDMODE_NOBLEND, 0);

	//デバッグ表示

	DrawString(0, 0, "SceneMain", GetColor(255, 255, 255));
	DrawFormatString(0, 16, GetColor(255, 255, 255), "FRAME:%d", m_frameCount);

	DrawFormatString(0, 32, GetColor(255, 255, 255), "HP:%d", m_player.GetHp());
}