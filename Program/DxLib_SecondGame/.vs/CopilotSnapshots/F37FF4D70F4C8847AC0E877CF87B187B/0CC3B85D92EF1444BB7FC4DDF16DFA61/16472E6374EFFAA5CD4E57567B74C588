//ゲーム実装で一般的な物理挙動を再現したジャンプ
void Player::Update()
{
	//無敵時間を減らす
	m_noDamageFrame--;
	if (m_noDamageFrame <= 0)m_noDamageFrame = 0;
	//死んでいる場合の特殊処理
	if (IsDead())
	{
		m_angle += 0.5f;
		//地面の下に突き抜けて下に落ちていく
		m_vec.y += kGravity;

		m_pos.x += m_vec.x;
		m_pos.y += m_vec.y;
		return;//死んでいる場合ここで終了　以降の生きている時の処理は行わない
	}
	if (m_isLanding)
	{
		//地面についている場合の処理
		//ジャンプできる
		//重力の影響を受けない
		int pad = GetJoypadInputState(DX_INPUT_KEY_PAD1);
		//1ボタンを押したらジャンプ開始
		if (pad & PAD_INPUT_1)
		{
			//	m_vec.x = 4.0f;

			m_vec.y = kJumpPower;
			m_isLanding = false;
		}
	}
	else
	{
		//ジャンプ中の処理
		//ジャンプ（多段ジャンプできない
		//重力の影響を受ける

		m_vec.y += kGravity;

		m_pos.x += m_vec.x;
		m_pos.y += m_vec.y;

		//地面についた時の処理
		if (m_pos.y >= kStartY)
		{
			//	m_vec.x = 0.0f;
			m_pos.y = kStartY;
			m_vec.y = 0.0f;
			m_isLanding = true;
		}
	}
