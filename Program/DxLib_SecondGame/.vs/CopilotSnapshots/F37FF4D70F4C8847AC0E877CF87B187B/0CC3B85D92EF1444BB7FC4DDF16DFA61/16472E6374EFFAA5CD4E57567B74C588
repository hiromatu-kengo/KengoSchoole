void Player::Draw()
{
	//m_noDamageFrameが偶数の場合
	//(m_noDamageFrame % 2) == 0
	//m_noDamageFrameが奇数の場合
	//(m_noDamageFrame % 2) == 1
//	if (m_noDamageFrame % 2) //1フレームごとにONOFFを切り替えると半透明に見えてしまう
	if ((m_noDamageFrame / 2) % 2)//2フレームごとにONOFFを切り替える
	{
		return;
	}
	//DrawGraph(100, 100, m_idleHandle, true);
	DrawRectRotaGraph(m_pos.x + kWidth / 2 , m_pos.y + kHeight / 2 ,0,0 , kWidth, kHeight,1.0, m_angle, m_idleHandle, true);

#ifdef _DEBUG
	//当たり判定のデバック表示
	DrawCircle(GetColCenter().x, GetColCenter().y, GetColRadius(), GetColor(255, 0, 0), false);
#endif // 
}

Vec2 Player::GetColCenter() const
{

	return m_pos;
}

float Player::GetColRadius() const
{
	return kColRadius;
}

void Player::OnHit()
{
	//無敵時間の間はぶつからない
	if (m_noDamageFrame > 0)
	{
		//ダメージ処理を行わず関数を終了する
		return;
	}
	if (IsDead())return;
	m_hp--;
	//一定時間無敵になる
	m_noDamageFrame = kNoDamageFrame;
	//HPが0以下にならないようにする
	if (m_hp <= 0)
	{
		m_hp = 0;
	}
	//死んだ瞬間の処理
	if (IsDead())
	{
		m_vec.x = -1.0f;
		m_vec.y = kJumpPower;
	}
}

bool Player::IsDead() const
{
	//return (m_hp <= 0);//こんな感じの書き方もできる

	//HP0以下なら死んでいる
	if (m_hp <= 0)
	{
		return true;
	}
	return false;
}
