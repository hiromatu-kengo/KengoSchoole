#include "Enemy.h"
#include"Dxlib.h"
#include"Game.h"

namespace
{
	//フェードにかかるフレーム数
	constexpr int kFadeFrame = 30;
	//のこぎりの位置
	constexpr int kStartUpY = Game::kScreenHeight - 240;
	constexpr int kStartDownY = Game::kScreenHeight - 120 + 32;
	//のこぎりの速度
	constexpr int kSpeed = 8.0f;
	//のこぎりの回転速度
	constexpr double kRotSpeed = 0.2;
	//大きさ
	constexpr int kWidth = 38;
	constexpr int kHeight = 38;
	//当たり判定
	constexpr int kColRadius = 16.0f;
	//上からのこぎりが登場する確率(%)
	constexpr int kUpRate = 20;

}

Enemy::Enemy() :
	m_graphHandle(-1),
	m_waitFrame(0),
	m_fadeFrame(0),
	m_isFadingOut(false),
	m_angle(0.0),
	m_rotSpeed(0.0),
	m_isFlip(false),
	m_appearCount(0)
{
}

Enemy::~Enemy()
{
}

void Enemy::Init()
{
	m_appearCount = 0;
	//初期位置
	Setup();

	m_angle = 0.0;
	m_rotSpeed = 1.0;
}

void Enemy::End()
{
}

void Enemy::Update()
{
	m_waitFrame--;
	if (m_waitFrame > 0)return;//まだ登場しない

	// 回転速度に応じて角度を進める
	m_angle += m_rotSpeed;

	// 前フレームの座標を保存（累積ではなく上書き）
	m_lastPos = m_pos;

	// フェードタイマーが動作していればカウントダウン
	if (m_fadeFrame > 0)
	{
		m_fadeFrame--;
	}

	m_pos.x += m_vec.x;
	m_pos.y += m_vec.y;

	//画面買いに出たのこぎりは左右どちらかから再登場する

	//右に移動しているのこぎりが画面右端から出てきた
	if ((m_vec.x > 0.0f)//右に移動している
		&& (m_pos.x > Game::kScreenWidth + kWidth / 2))
	{
		// 画面外に出たらフェードアウトを開始する
		if (!m_isFadingOut)
		{
			m_isFadingOut = true;
			m_fadeFrame = kFadeFrame;
		}
	}
	//左に移動しているのこぎりが画面左端から出てきた
	if ((m_vec.x < 0.0f)//左に移動している
		&& (m_pos.x < 0.0f - kWidth / 2))
	{
		// 画面外に出たらフェードアウトを開始する
		if (!m_isFadingOut)
		{
			m_isFadingOut = true;
			m_fadeFrame = kFadeFrame;
		}
	}

	// フェードアウトが完了したら再出現処理
	if (m_isFadingOut && m_fadeFrame <= 0)
	{
		Setup();
	}
}

void Enemy::Draw()
{
#ifdef _DEBUG
	// 当たり判定デバッグ表示のため、アルファ操作の前にブレンドを設定
#endif
	if (m_graphHandle != -1)
	{
		int alpha = 255;
		if (m_fadeFrame > 0)
		{
			if (m_isFadingOut)
			{
				// フェードアウト: m_fadeFrame=kFadeFrame -> alpha=255, 0->0
				alpha = static_cast<int>(255.0f * (static_cast<float>(m_fadeFrame) / kFadeFrame));
			}
			else
			{
				// フェードイン: m_fadeFrame=kFadeFrame -> alpha=0, 0->255
				alpha = static_cast<int>(255.0f * (1.0f - static_cast<float>(m_fadeFrame) / kFadeFrame));
			}
			if (alpha < 0) alpha = 0;
			if (alpha > 255) alpha = 255;
		}
		SetDrawBlendMode(DX_BLENDMODE_ALPHA, alpha);
		DrawRotaGraph(m_pos.x, m_pos.y, 1.0, m_angle, m_graphHandle, true);
		SetDrawBlendMode(DX_BLENDMODE_NOBLEND, 0);
	}
#ifdef _DEBUG
	//当たり判定のデバック表示
	DrawCircle((int)GetColCenter().x, (int)GetColCenter().y, (int)GetColRadius(), GetColor(255, 0, 0), FALSE);
#endif // 
}

Vec2 Enemy::GetColCenter() const
{
	return m_pos;
}

float Enemy::GetColRadius() const
{
	return kColRadius;
}

void Enemy::Setup()
{
	// 1 / 2の確率で右、もしくは左から出てくる

		//0課1をランダムに生成して、
		//0の場合は左から1の場合は右から登場
	if (GetRand(1))
	{
		//GetRand()の結果が0でない場合こちらかが実行される
		//右から
		m_pos.x = Game::kScreenWidth + kWidth / 2;
		m_vec.x = -kSpeed;		//左方向に移動する
		m_angle = -m_rotSpeed;
		m_isFlip = false;
	}
	else
	{
		//GetRand()の結果が0の場合はこちらが実行される
		//左から
		m_pos.x = 0 - kWidth / 2;
		m_vec.x = +kSpeed;		//右方向に移動する
		m_angle = m_rotSpeed;
		m_isFlip = true;
	}
	
	//GetRand(99)で０～９９までのランダムな数を生成
	//20%の確率で何かをしたい場合、0,1,2,3.....18,19のいずれかが出たら何かする
	if (GetRand(99) < kUpRate)
	{
		m_pos.y = kStartUpY;
	}
	else
	{
		m_pos.y = kStartDownY;
	}
	m_vec.y = 0.0f;
	// フェードインを開始する
	m_isFadingOut = false;
	m_fadeFrame = kFadeFrame;
	m_lastPos.x = m_pos.x;
	m_lastPos.y = m_pos.y;

	//登場待ち時間を設定する
	m_waitFrame = GetRand(32);

	//登場回数を増やす
	m_appearCount++;
}
