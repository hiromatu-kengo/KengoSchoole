#include "SceneMain.h"
#include"DxLib.h"
#include"Game.h"

namespace
{
	constexpr int kPlayerHandle = 0;
}

SceneMain::SceneMain() :
	m_frameCount(0),
	m_playerHandle(-1),
	m_enemyGraphHandle(-1),
	m_lifeGraphHandle(-1),
	m_bgGraphHandle(-1),
	m_scoreFontHandle(-1),
	m_gameoverFontHandle(-1),
	m_sinAngle(0.0f),
	m_score(0)
{
}

SceneMain::~SceneMain()
{
}

void SceneMain::Init()
{
	//グラフィックリソースのロード
	m_playerHandle = LoadGraph("data/image/idle.png");
	m_enemyGraphHandle = LoadGraph("data/image/Saw.png");
	m_lifeGraphHandle = LoadGraph("data/image/Kiwi.png");
	m_bgGraphHandle = LoadGraph("data/image/mapchi.png");

	//フォントの生成
	m_gameoverFontHandle = CreateFontToHandle("ＭＳ 明朝", 48, -1, -1);

	m_player.SetIdleHandle(m_playerHandle);
	m_player.Init();

	m_enemy.SetGraphHandle(m_enemyGraphHandle);
	m_enemy.Init();

	for (int i = 0;i < kLifeMax;i++)
	{
		m_life[i].SetGraphHandle(m_lifeGraphHandle);
		m_life[i].Init();
		Vec2 pos;
		pos.x = Game::kScreenWidth / 2 - 120 + 120 * i;
		pos.y = 160;
		m_life[i].SetPos(pos);
	}

	m_bg.SetHandle(m_bgGraphHandle);
	m_bg.Init();

	m_frameCount = 0;
	m_score = 0;
}

void SceneMain::End()
{
	//グラフィックを開放
	DeleteGraph(m_playerHandle);
	DeleteGraph(m_enemyGraphHandle);
	DeleteGraph(m_bgGraphHandle);

	//フォントの削除
	DeleteFontToHandle(m_scoreFontHandle);
	DeleteFontToHandle(m_gameoverFontHandle);

	m_player.End();
	m_enemy.End();
	for (int i = 0;i < kLifeMax;i++)
	{
		m_life[i].End();
	}
	m_bg.End();
}

void SceneMain::Update()
{
	m_frameCount++;
	m_sinAngle += 0.05f;
	m_player.Update();
	m_enemy.Update();
	for (int i = 0;i < kLifeMax;i++)
	{
		m_life[i].Update();
	}
	//当たり判定
	{
		//playerの中心からenemyの中心に伸びるベクトルを取得する
		//終点の座標からして院の座標を引くことで視点から終点へのベクトルを求める
		Vec2 playerToEnemy;
		playerToEnemy.x = m_enemy.GetColCenter().x - m_player.GetColCenter().x;
		playerToEnemy.y = m_enemy.GetColCenter().y - m_player.GetColCenter().y;

		//半径の合計
		float sumRadius = m_player.GetColRadius() + m_enemy.GetColRadius();
		if (playerToEnemy.SqLength() < (sumRadius * sumRadius))
		{
		//	printfDx("当たった\n");
			m_player.OnHit();
		}
		m_bg.Update();
	}
	//ライフの数だけライフのアイコンを表示する
	for (int i = 0;i < kLifeMax;i++)
	{
		//m_life[i].SetVisible(i < m_player.GetHp());
		if (i < m_player.GetHp())
		{
			m_life[i].SetVisible(true);
		}
		else
		{
			m_life[i].SetVisible(false);
		}
	}
	//現在のスコアを計算する
//	if(m_player.IsDead() == false)
	if (!m_player.IsDead())
	{
		m_score = m_enemy.GetAppearCount()*100;
	}
}

void SceneMain::Draw()
{
	m_bg.Draw();
	m_player.Draw();
	m_enemy.Draw();
	for (int i = 0;i < kLifeMax;i++)
	{
		m_life[i].Draw();
	}
	//スコア(のこぎり登場回数)
	{
		//文字列の横幅をお取得する
		int width = GetDrawFormatStringWidthToHandle(m_gameoverFontHandle, "%d", m_score);

		//右揃えで表示
		int x = (Game::kScreenWidth - 32) - width;
		int y = 32;
		DrawFormatStringToHandle(x, y, GetColor(255, 255, 255), m_gameoverFontHandle, "%d", m_score);
	}

	//ゲームオーバー表示
	if (m_player.IsDead())
	{
		//文字列の横幅を取得
		int width = GetDrawStringWidthToHandle("GAME OVER!", strlen("GAME OVER!"), m_gameoverFontHandle);

		int x = Game::kScreenWidth / 2 - width / 2 + cosf(m_sinAngle)*11;
		int y = 200 + sinf(m_sinAngle) * 16;
		DrawStringToHandle(x, y, "GAME OVER!", GetColor(200, 32, 32), m_gameoverFontHandle);
	}

	//デバッグ表示

	DrawString(0, 0, "SceneMain", GetColor(255, 255, 255));
	DrawFormatString(0, 16, GetColor(255, 255, 255), "FRAME:%d", m_frameCount);

	DrawFormatString(0, 32, GetColor(255, 255, 255), "HP:%d", m_player.GetHp());
}